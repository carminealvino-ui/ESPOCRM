<div class="commission-dashboard ck-compact">
<style>
.commission-dashboard{font-size:12px;color:inherit}.commission-dashboard button{font:inherit}.commission-dashboard .ck-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px}.commission-dashboard .ck-muted{color:#7c8796;font-size:11px}.commission-dashboard .ck-link{background:none;border:0;color:#4679a6;padding:1px 3px}.commission-dashboard .ck-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-bottom:8px}.commission-dashboard .ck-card{border:1px solid #d9dfe7;border-top:3px solid #63a7c2;border-radius:5px;background:var(--panel-bg,#fff);text-align:left;padding:9px 12px;color:inherit;min-width:0}.commission-dashboard .ck-card strong{display:block;font-size:21px;line-height:1.3;margin:4px 0;font-variant-numeric:tabular-nums}.commission-dashboard .ck-card small{font-size:10px;color:#7c8796}.commission-dashboard .ck-card.ck-next{border-top-color:#a979ce}
.commission-dashboard .ck-main{display:grid;grid-template-columns:minmax(240px,1fr) minmax(400px,1.65fr) minmax(220px,.85fr);gap:8px}.commission-dashboard .ck-panel{border:1px solid #d9dfe7;border-radius:5px;padding:10px;background:var(--panel-bg,#fff);min-width:0}.commission-dashboard h4{font-size:13px;font-weight:600;margin:0 0 7px}.commission-dashboard .ck-tabs{display:flex;gap:3px;flex-wrap:wrap;margin-bottom:5px}.commission-dashboard .ck-tabs button{font-size:10px;border:1px solid #d9dfe7;border-radius:3px;background:none;color:inherit;padding:2px 5px}.commission-dashboard .ck-tabs button.active{background:#e8f2f8;border-color:#63a7c2;color:#245b75}
.commission-dashboard .ck-stage{position:relative;display:block;width:100%;height:36px;background:none;border:0;padding:0;margin:0 0 2px;color:#172b3b;text-align:center}.commission-dashboard .ck-stage svg{position:absolute;inset:0;width:100%;height:100%}.commission-dashboard .ck-stage span{position:relative;background:rgba(255,255,255,.88);padding:1px 5px;border-radius:2px;font-size:11px;white-space:nowrap}.commission-dashboard .ck-exclusions{display:flex;gap:5px;justify-content:space-between;margin-top:7px}.commission-dashboard .ck-exclusions button{border:0;background:none;padding:0;text-align:left;color:inherit;font-size:10px}.commission-dashboard .ck-exclusions strong{display:block;margin-top:2px;font-size:11px}.commission-dashboard .ck-table{width:100%;border-collapse:collapse;white-space:nowrap}.commission-dashboard .ck-table th{font-size:10px;font-weight:500;color:#7c8796}.commission-dashboard .ck-table td,.commission-dashboard .ck-table th{padding:7px 4px;text-align:right;border-bottom:1px solid #eef0f4}.commission-dashboard .ck-table td:first-child,.commission-dashboard .ck-table th:first-child{text-align:left}.commission-dashboard .ck-table button{border:0;background:none;color:inherit;padding:0;font-variant-numeric:tabular-nums}.commission-dashboard .ck-row{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;border:0;border-bottom:1px solid #eef0f4;background:none;padding:8px 0;color:inherit;text-align:left}.commission-dashboard .ck-row strong{white-space:nowrap;font-variant-numeric:tabular-nums}.commission-dashboard .ck-bottom{display:grid;grid-template-columns:minmax(0,3fr) minmax(220px,1fr);gap:8px;margin-top:8px}.commission-dashboard .ck-panel-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}.commission-dashboard .ck-warning{color:#ad6710}.commission-dashboard .ck-note{margin:6px 0 0;font-size:10px;color:#7c8796;line-height:1.4}.commission-dashboard .ck-foot{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:#7c8796;margin-top:6px}.commission-dashboard button:hover{background-color:#f4f7fb}.commission-dashboard button:focus-visible{outline:2px solid #3184bc;outline-offset:2px}.commission-dashboard .ck-scroll{overflow-x:auto}
@media(max-width:1150px){.commission-dashboard .ck-main{grid-template-columns:1fr 1.5fr}.commission-dashboard .ck-liquidation{grid-column:1/-1;display:flex;gap:12px;align-items:center}.commission-dashboard .ck-liquidation h4{margin:0;min-width:100px}.commission-dashboard .ck-liquidation .ck-row{display:block;border:0;padding:0}.commission-dashboard .ck-liquidation strong{display:block}.commission-dashboard .ck-card strong{font-size:18px}}
@media(max-width:700px){.commission-dashboard .ck-grid{grid-template-columns:repeat(2,1fr)}.commission-dashboard .ck-main,.commission-dashboard .ck-bottom{grid-template-columns:1fr}.commission-dashboard .ck-liquidation{display:block}.commission-dashboard .ck-liquidation .ck-row{display:flex;padding:7px 0}.commission-dashboard .ck-toolbar{align-items:flex-start}.commission-dashboard .ck-foot{display:block}}

.commission-dashboard .ck-workspace{display:grid;grid-template-columns:minmax(240px,1fr) minmax(400px,1.65fr) minmax(220px,.85fr);gap:8px}
.commission-dashboard .ck-main,.commission-dashboard .ck-bottom{display:contents}
.commission-dashboard .ck-funnel-panel{grid-column:1;grid-row:1 / 3;display:flex;flex-direction:column}
.commission-dashboard .ck-composition{grid-column:2;grid-row:1}
.commission-dashboard .ck-liquidation{grid-column:3;grid-row:1}
.commission-dashboard .ck-forecast-panel{grid-column:2;grid-row:2}
.commission-dashboard .ck-checks{grid-column:3;grid-row:2}
.commission-dashboard .ck-funnel-panel .ck-stage{flex:1;min-height:64px}
.commission-dashboard .ck-funnel-panel .ck-tabs{margin-bottom:10px}
.commission-dashboard .ck-funnel-panel .ck-exclusions{margin-top:10px}
.commission-dashboard .ck-forecast-panel .ck-table td,.commission-dashboard .ck-forecast-panel .ck-table th{padding:7px 3px}
@media(max-width:1150px){
.commission-dashboard .ck-workspace{grid-template-columns:minmax(220px,1fr) minmax(400px,1.65fr)}
.commission-dashboard .ck-funnel-panel{grid-row:1 / 4}
.commission-dashboard .ck-liquidation{grid-column:2;grid-row:2;display:block}
.commission-dashboard .ck-liquidation .ck-row{display:flex;padding:7px 0;border-bottom:1px solid #eef0f4}
.commission-dashboard .ck-forecast-panel{grid-column:2;grid-row:3}
.commission-dashboard .ck-checks{grid-column:1 / -1;grid-row:4}
}
@media(max-width:700px){
.commission-dashboard .ck-workspace{display:flex;flex-direction:column}
.commission-dashboard .ck-funnel-panel .ck-stage{flex:auto;height:48px;min-height:48px}
}
</style>
<div class="ck-toolbar"><span><strong>{{brand}}</strong> <span class="ck-muted">· {{period}} · al {{today}}</span></span><span><button class="ck-link" data-action="definitions">Criteri e legenda</button> · <button class="ck-link" data-action="refresh" title="Aggiorna"><span class="fas fa-sync-alt"></span></button></span></div>
{{#if loadError}}<div class="alert alert-danger">{{loadError}}</div>{{else}}{{#if ready}}
<div class="ck-grid">{{#each cards}}<button class="ck-card" data-column-total="{{key}}"><span>{{label}}</span><strong>{{value}}</strong><small>{{count}} contratti · dettaglio</small></button>{{/each}}</div>
<div class="ck-workspace"><div class="ck-main">
<section class="ck-panel ck-funnel-panel"><h4>Funnel · provvigioni · tutto lo storico</h4><div class="ck-tabs">{{#each funnelChoices}}<button data-funnel-category="{{key}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div>
{{#each funnel}}<button class="ck-stage" data-lifetime-metric="{{key}}" data-category="{{category}}" title="{{label}} · {{value}} · {{percent}}"><svg viewBox="0 0 1000 36" preserveAspectRatio="none" aria-hidden="true"><polygon points="{{points}}" fill="{{color}}"/></svg><span>{{label}} <strong>{{value}}</strong> · {{percent}}</span></button>{{/each}}
<p class="text-muted" style="font-size:11px">Tutto lo storico, inclusi inviti, pagate e chiuse. Nette = lorde − recessi − finanziamenti KO. Percentuali sulle lorde.</p><div class="ck-exclusions">{{#each exclusions}}<button data-lifetime-metric="{{key}}" data-category="{{category}}">{{label}} · {{count}} contratti<strong>{{value}}</strong></button>{{/each}}</div>

</section>
<section class="ck-panel ck-composition"><h4>Composizione degli importi</h4><div class="ck-scroll"><table class="ck-table"><thead><tr><th>Voce</th><th>In pagamento + stima + sospesi</th><th>Sospesi</th><th>In pagamento + stima</th><th>Prossimo invito</th><th>Stima futura</th></tr></thead><tbody>{{#each composition}}<tr><td>{{label}}</td>{{#each cells}}<td><button data-report-category="{{category}}" data-key="{{key}}">{{value}}{{#if monthlyOnly}}*{{/if}}</button></td>{{/each}}</tr>{{/each}}</tbody></table></div></section>
<section class="ck-panel ck-liquidation"><h4>Liquidazione · pagamenti</h4>{{#each settlement}}<button class="ck-row" data-liquidation="{{key}}"><span>{{label}}</span><strong>{{value}}</strong></button>{{/each}}</section>
</div>
<div class="ck-bottom"><section class="ck-panel ck-forecast-panel"><div class="ck-panel-head"><h4>Inviti attesi · provvigioni, plus/minus e bonus</h4><button class="ck-link" data-action="allForecast">Calendario completo ({{forecastCount}})</button></div><div class="ck-scroll"><table class="ck-table"><thead><tr><th>Fornitore / data</th><th>Provvigioni</th><th>Plus</th><th>Minus</th><th>Bonus</th><th>Totale</th></tr></thead><tbody>{{#each forecast}}<tr><td><button data-forecast="{{index}}">{{supplierName}} · {{date}}{{#if overdue}} <span class="ck-warning">arretrato</span>{{else}}{{#if next}} · prossimo{{/if}}{{/if}}</button></td>{{#each parts}}<td>{{#if hasValue}}<button data-forecast="{{index}}" data-category="{{category}}">{{value}}</button>{{else}}—{{/if}}</td>{{/each}}<td><button data-forecast="{{index}}"><strong>{{value}}</strong></button></td></tr>{{else}}<tr><td colspan="6">Nessuna quota disponibile con data prevista.</td></tr>{{/each}}</tbody></table></div>{{#if forecastWarning}}{{/if}}</section>
<section class="ck-panel ck-checks"><h4>Da verificare</h4>{{#each alerts}}<button class="ck-row" data-metric="{{key}}"><span>{{label}} <span class="ck-muted">({{count}})</span></span><strong>{{value}}</strong></button>{{/each}}{{#if reconciliation}}{{/if}}</section></div>
</div>
{{/if}}{{/if}}</div>
