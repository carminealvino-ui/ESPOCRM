<div class="appointment-kpi">
<div class="ak-header"><span><a href="javascript:" data-action="definitions">Criteri e legenda</a> · <a href="javascript:" data-action="refresh" aria-label="Aggiorna appuntamenti"><span class="fas fa-sync-alt"></span></a></span></div>
{{#if loadError}}<p class="text-danger">{{loadError}}</p>{{/if}}
{{#if ready}}
<div class="ak-cards">{{#each cards}}<div class="ak-box ak-card" data-appointment-key="{{key}}" role="button" tabindex="0"><div>{{label}}</div><div class="ak-value">{{count}} <span class="ak-card-percent">{{percent}}</span></div><div class="ak-small">sul totale · dettaglio</div></div>{{/each}}</div>
<div class="ak-workspace"><div class="ak-grid">
<section class="ak-box"><h4>Funnel appuntamenti</h4><p class="ak-small">{{cardPeriodLabel}}</p>{{#each funnel}}<div class="ak-stage" data-appointment-key="{{key}}" role="button" tabindex="0" aria-label="{{label}}: {{count}}"><svg viewBox="0 0 1000 85" preserveAspectRatio="none" aria-hidden="true"><polygon points="{{points}}" fill="{{color}}"></polygon></svg><div class="ak-stage-label"><span>{{label}}<br><strong>{{count}}</strong> · {{percent}}</span></div></div>{{/each}}<p class="ak-small" style="margin-top:8px">Totali → lordi → netti → conclusi positivamente. Pianificati e rifissati fuori dalla base.</p></section>
<section class="ak-box"><h4>Appuntamenti per mese</h4><p class="ak-small">Mesi recenti · {{monthRange}} · <span style="color:#63a7c2">■ Totali</span> <span style="color:#5cb85c">■ Netti</span> <span style="color:#18794e">■ Conclusi</span></p><div class="ak-month-chart">{{#each months}}<div class="ak-month" role="button" tabindex="0" data-appointment-key="{{key}}" data-group="months" data-subkey="totali" aria-label="{{key}}: {{count}} totali, {{netti}} netti"><button class="ak-month-count ak-month-ratio" data-appointment-key="{{key}}" data-group="months" data-subkey="conclusi" aria-label="{{key}}: {{positive}} conclusi su {{count}} totali, {{positiveRate}}"><strong>{{positive}}/{{count}}</strong><small>{{positiveRate}}</small></button><span class="ak-track"><span class="ak-bar" style="height:{{width}}%"><span class="ak-net-bar" style="height:{{netWidth}}%"><button class="ak-positive-bar" style="height:{{positiveWidth}}%" data-appointment-key="{{key}}" data-group="months" data-subkey="conclusi" aria-label="{{key}}: {{positive}} conclusi positivamente"></button></span></span></span><span class="ak-month-name">{{key}}</span></div>{{else}}<p class="ak-small">Nessun appuntamento datato.</p>{{/each}}</div></section>
<section class="ak-box"><h4>Riepilogo</h4><p class="ak-small">{{cardPeriodLabel}}</p><div class="ak-line"><span>Netti / totali</span><strong>{{conversion}}</strong></div>{{#each extras}}<div class="ak-line" data-appointment-key="{{key}}" role="button" tabindex="0"><span>{{label}}</span><strong>{{count}}</strong></div>{{/each}}<p class="ak-small" style="margin-top:8px">Svolti è un conteggio per stato, distinto dagli appuntamenti netti.</p></section>
</div>
<div class="ak-lower"><section class="ak-box ak-areas"><div class="ak-area-heading"><h4>Appuntamenti per zona</h4><span class="ak-small ak-legend"><i class="ak-dot ak-net"></i>Netti <i class="ak-dot ak-positive"></i>Conclusi <i class="ak-dot ak-cancelled"></i>Annullati <i class="ak-dot ak-unmanageable"></i>Ingestibili</span></div><div class="ak-area-chart">{{#each areas}}<div class="ak-area-column"><button class="ak-area-total" data-appointment-key="{{key}}" data-group="areas" data-subkey="totali" aria-label="{{name}}: {{total}} appuntamenti totali">{{total}}</button><div class="ak-area-plot"><div class="ak-area-stack" style="height:{{width}}%"><div class="ak-area-segment ak-net" style="height:{{netHeight}}%"><button class="ak-area-net-main" style="height:calc(100% - {{positiveHeight}}%)" data-appointment-key="{{key}}" data-group="areas" data-subkey="netti" aria-label="{{name}}: {{net}} netti" title="{{net}} netti"><span class="ak-bar-number">{{net}}</span></button><button class="ak-area-positive-main" style="height:{{positiveHeight}}%" data-appointment-key="{{key}}" data-group="areas" data-subkey="conclusi" aria-label="{{name}}: {{positive}} conclusi" title="{{positive}} conclusi"><span class="ak-bar-number">{{positive}}</span></button></div><button class="ak-area-segment ak-cancelled" style="height:{{cancelledHeight}}%" data-appointment-key="{{key}}" data-group="areas" data-subkey="annullati" aria-label="{{name}}: {{cancelled}} annullati" title="{{cancelled}} annullati"><span class="ak-bar-number">{{cancelled}}</span></button><button class="ak-area-segment ak-unmanageable" style="height:{{unmanageableHeight}}%" data-appointment-key="{{key}}" data-group="areas" data-subkey="ingestibili" aria-label="{{name}}: {{unmanageable}} ingestibili" title="{{unmanageable}} ingestibili"><span class="ak-bar-number">{{unmanageable}}</span></button></div></div><strong class="ak-area-label">{{name}}</strong></div>{{else}}<p class="ak-small">Nessun appuntamento nel periodo selezionato.</p>{{/each}}</div></section><section class="ak-box ak-conclusions"><h4>Percentuali sulle conclusioni</h4><div class="ak-small">{{positive}} conclusi positivamente · {{cardPeriodLabel}}</div><div class="ak-rate-cards">{{#each conclusionRates}}<button data-appointment-key="conclusi" aria-label="Conclusi {{label}}: {{rate}}"><span>{{label}}</span><strong>{{rate}}</strong><small>{{positive}} / {{base}}</small></button>{{/each}}</div><div class="ak-zone-caption ak-small">Per zona · conclusi / base indicata</div><div class="ak-zone-matrix"><div class="ak-zone-matrix-head"><span>Zona</span><span>Su totali</span><span>Su lordi</span><span>Su netti</span></div>{{#each zoneRates}}<div class="ak-zone-matrix-row"><span class="ak-zone-matrix-name">{{name}}</span>{{#each rates}}<button data-appointment-key="{{key}}" data-group="areas" data-subkey="conclusi" aria-label="{{../name}}: {{positive}} conclusi su {{base}} {{label}}, {{rate}}"><strong>{{rate}}</strong><small>{{positive}}/{{base}}</small></button>{{/each}}</div>{{else}}<p class="ak-small">Nessun appuntamento nel periodo.</p>{{/each}}</div></section></div></div>
{{/if}}</div>




