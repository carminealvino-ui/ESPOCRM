<style>
.sales-kpi .sk-cards{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:8px 0}.sales-kpi .sk-box{border:1px solid #d5ddeb;border-radius:4px;padding:10px;min-width:0}.sales-kpi .sk-card{border-top:3px solid #63a7c2;cursor:pointer}.sales-kpi .sk-value{font-size:22px;font-weight:600;margin:5px 0}.sales-kpi .sk-grid{display:grid;grid-template-columns:28% 47% 24%;gap:8px}.sales-kpi h4{font-size:14px;margin:0 0 10px}.sales-kpi .sk-small{font-size:11px;color:#8996ae}.sales-kpi [data-sales-key]{cursor:pointer}.sales-kpi [data-sales-key]:hover{background:#f4f8fc}.sales-kpi [data-sales-key]:focus{outline:2px solid #63a7c2}.sales-kpi table{width:100%;font-size:12px}.sales-kpi td,.sales-kpi th{padding:9px 4px;border-bottom:1px solid #e9edf5}.sales-kpi th{font-weight:400;color:#8996ae;font-size:11px}.sales-kpi .sk-right{text-align:right;white-space:nowrap}.sales-kpi .sk-months{max-height:390px;overflow:auto}.sales-kpi .sk-line{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-bottom:1px solid #e9edf5}@media(max-width:1050px){.sales-kpi .sk-grid{grid-template-columns:1fr}.sales-kpi .sk-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
.sales-kpi .sk-funnel{margin:0 0 16px}.sales-kpi .sk-stage{position:relative;height:108px;margin:0;padding:0;overflow:hidden}.sales-kpi .sk-stage svg{position:absolute;inset:0;display:block;width:100%;height:100%}.sales-kpi .sk-stage-label{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12px;line-height:1.5;pointer-events:none}.sales-kpi .sk-stage-label span{max-width:88%;padding:2px 5px;background:rgba(255,255,255,.88);border-radius:2px}.sales-kpi .sk-stage-label small{font-size:11px;color:#63768d}.sales-kpi .sk-stage:last-child .sk-stage-label{align-items:flex-start;padding-top:10px}.sales-kpi .sk-stage:hover{filter:brightness(1.04)}
.sales-kpi .sk-month-chart{max-height:430px;overflow:auto;padding-right:6px}.sales-kpi .sk-month-row{display:grid;grid-template-columns:60px minmax(40px,1fr) 115px;align-items:center;gap:12px;width:100%;border:0;border-bottom:1px solid #e9edf5;background:none;color:inherit;padding:12px 4px;text-align:left;font:inherit}.sales-kpi .sk-month-name{font-size:12px;white-space:nowrap}.sales-kpi .sk-month-track{display:block;height:23px;background:#f0f4f8;border-radius:3px;overflow:hidden}.sales-kpi .sk-month-bar{display:block;height:100%;background:#63a7c2;border-radius:3px}.sales-kpi .sk-month-bar.sk-negative{background:#c96947}.sales-kpi .sk-month-total{text-align:right;white-space:nowrap;font-size:12px}.sales-kpi .sk-month-total small{display:block;color:#8996ae;font-size:11px;margin-top:3px}@media(max-width:500px){.sales-kpi .sk-month-row{grid-template-columns:52px minmax(25px,1fr) 100px;gap:6px}}
.sales-kpi .sk-month-chart{display:flex;gap:12px;align-items:stretch;overflow-x:auto;overflow-y:hidden;max-height:none;padding:16px 4px 10px;height:405px}.sales-kpi .sk-month-row{position:relative;display:flex;flex:0 0 88px;flex-direction:column;gap:0;align-items:center;justify-content:flex-end;width:88px;min-width:88px;border:0;padding:0 2px 4px}.sales-kpi .sk-month-track{order:1;position:relative;display:flex;align-items:flex-end;justify-content:center;width:100%;height:278px;flex-shrink:0;border-radius:0;border-bottom:1px solid #cbd6e2;background:repeating-linear-gradient(to top,#edf1f6 0,#edf1f6 1px,transparent 1px,transparent 69px);overflow:visible}.sales-kpi .sk-month-bar{width:42px;height:0;border-radius:3px 3px 0 0}.sales-kpi .sk-month-name{order:2;margin-top:10px}.sales-kpi .sk-month-total{order:0;width:100%;text-align:center;white-space:nowrap;font-size:11px;min-height:48px;display:flex;flex-direction:column;justify-content:center}.sales-kpi .sk-month-total small{font-size:10px}@media(max-width:500px){.sales-kpi .sk-month-row{display:flex;gap:0;flex-basis:88px}}
.sales-kpi .sk-month-chart{height:350px;gap:6px;padding:6px 2px 8px}.sales-kpi .sk-month-row{flex:1 0 38px;width:38px;min-width:38px;max-width:48px;padding:0 1px 2px}.sales-kpi .sk-month-track{height:180px;background:repeating-linear-gradient(to top,#edf1f6 0,#edf1f6 1px,transparent 1px,transparent 45px)}.sales-kpi .sk-month-bar{width:24px}.sales-kpi .sk-month-total{min-height:88px;height:88px;flex-shrink:0;flex-direction:row;align-items:center;justify-content:center;gap:3px;font-size:10px}.sales-kpi .sk-month-total strong,.sales-kpi .sk-month-total small{writing-mode:vertical-rl;transform:rotate(180deg);line-height:13px;margin:0;white-space:nowrap}.sales-kpi .sk-month-total small{font-size:9px}.sales-kpi .sk-month-name{writing-mode:vertical-rl;transform:rotate(180deg);height:54px;margin-top:6px;font-size:10px;line-height:13px;flex-shrink:0}@media(max-width:500px){.sales-kpi .sk-month-row{flex:1 0 38px}}
.sales-kpi .sk-month-chart{gap:2px;overflow:hidden;padding-left:2px;padding-right:2px}.sales-kpi .sk-month-row{flex:1 1 0;width:auto;min-width:0;max-width:none;padding-left:0;padding-right:0}.sales-kpi .sk-month-bar{width:22px;max-width:85%}.sales-kpi .sk-month-total{gap:0;font-size:10px}.sales-kpi .sk-month-total strong,.sales-kpi .sk-month-total small{line-height:12px}@media(max-width:500px){.sales-kpi .sk-month-row{flex:1 1 0;min-width:0}}
.sales-kpi .sk-box{padding:8px}.sales-kpi .sk-cards{margin:6px 0;gap:6px}.sales-kpi .sk-card{padding:6px 10px}.sales-kpi .sk-value{font-size:20px;margin:3px 0}.sales-kpi h4{margin-bottom:6px;font-size:13px}.sales-kpi .sk-line{padding:7px 0;font-size:12px}.sales-kpi .sk-box>p.sk-small{margin-bottom:5px}.sales-kpi .sk-stage{height:78px}.sales-kpi .sk-funnel{margin-bottom:8px}.sales-kpi .sk-month-chart{height:310px;padding-top:0}.sales-kpi .sk-month-track{height:150px;background:repeating-linear-gradient(to top,#edf1f6 0,#edf1f6 1px,transparent 1px,transparent 37.5px)}.sales-kpi .sk-month-total{height:84px;min-height:84px}.sales-kpi .sk-month-name{height:50px;margin-top:4px}@media(min-width:1051px) and (max-height:850px){.sales-kpi .sk-stage{height:65px}.sales-kpi .sk-line{padding:5px 0}.sales-kpi .sk-month-chart{height:280px}.sales-kpi .sk-month-track{height:125px}.sales-kpi .sk-box{padding:6px}.sales-kpi .sk-value{font-size:19px}}
.sales-kpi .sk-month-bar{display:flex;flex-direction:column-reverse;overflow:hidden}.sales-kpi .sk-month-segment{display:block;width:100%;flex-shrink:0}.sales-kpi .sk-segment-netti{background:#63a7c2}.sales-kpi .sk-segment-finanziamentiRifiutati{background:#9c6ac4}.sales-kpi .sk-segment-recessi{background:#d65f59}.sales-kpi .sk-segment-sospesi{background:#d6ae45}.sales-kpi .sk-bar-legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:10px;color:#63768d;margin:0 0 5px}.sales-kpi .sk-bar-legend span{display:inline-flex;align-items:center;gap:4px}.sales-kpi .sk-bar-legend i{display:inline-block;width:9px;height:9px;border-radius:2px}
.sales-kpi .sk-segment-netti{background:#0072b2;background-image:none}.sales-kpi .sk-segment-finanziamentiRifiutati{background-color:#111827;background-image:repeating-linear-gradient(135deg,transparent 0,transparent 4px,#fff 4px,#fff 6px)}.sales-kpi .sk-segment-recessi{background-color:#e69f00;background-image:radial-gradient(#111827 1px,transparent 1.6px);background-size:5px 5px}.sales-kpi .sk-segment-sospesi{background-color:#e7edf3;background-image:repeating-linear-gradient(0deg,transparent 0,transparent 4px,#334155 4px,#334155 6px)}.sales-kpi .sk-month-segment{box-shadow:inset 0 1px 0 #fff,inset 0 -1px 0 rgba(0,0,0,.25)}.sales-kpi .sk-bar-legend{color:#25364a;font-size:11px;gap:7px 14px}.sales-kpi .sk-bar-legend i{width:15px;height:12px;border:1px solid #334155;border-radius:1px}
.sales-kpi .sk-segment-netti{background:#0072b2;background-image:none}.sales-kpi .sk-segment-finanziamentiRifiutati{background:#d7191c;background-image:none}.sales-kpi .sk-segment-recessi{background:#ed8b00;background-image:none}.sales-kpi .sk-segment-sospesi{background:#d4d9df;background-image:none}
</style>
<div class="sales-kpi">
<div style="display:flex;justify-content:space-between"><span><strong>{{brand}}</strong><span class="sk-small"> · Report totale · tutto lo storico · al {{today}}</span></span><span><a href="javascript:" data-action="definitions">Criteri e legenda</a> · <a href="javascript:" data-action="refresh" aria-label="Aggiorna vendite"><span class="fas fa-sync-alt"></span></a></span></div>
{{#if loadError}}<p class="text-danger">{{loadError}}</p>{{/if}}
{{#if ready}}
<div class="sk-small" style="margin-top:8px">Riquadri superiori · {{cardPeriodLabel}} · periodo configurabile nelle opzioni</div><div class="sk-cards">{{#each cards}}<div class="sk-box sk-card" data-sales-key="{{key}}" data-sales-group="cards" role="button" tabindex="0"><div>{{label}}</div><div class="sk-value">{{value}}</div><div class="sk-small">{{count}} contratti · dettaglio</div></div>{{/each}}</div>
<div class="sk-grid">
<section class="sk-box"><h4>Funnel · vendite · periodo selezionato</h4><p class="sk-small">{{cardPeriodLabel}}</p><div class="sk-funnel">{{#each funnel}}<div class="sk-stage" data-sales-key="{{key}}" data-sales-group="cards" role="button" tabindex="0" aria-label="{{label}}: {{value}}, {{count}} contratti"><svg viewBox="0 0 1000 85" preserveAspectRatio="none" aria-hidden="true"><polygon points="{{points}}" fill="{{color}}"></polygon></svg><div class="sk-stage-label"><span>{{label}} <strong>{{value}}</strong> · {{percent}}<br><small>{{count}} contratti</small></span></div></div>{{/each}}</div><p class="sk-small">Totali → esclusi recessi → esclusi finanziamenti KO → esclusi sospesi. Percentuali sugli importi totali.</p>{{#if signed}}<p class="sk-small">Importi con segno: larghezze indipendenti, valori non decrescenti.</p>{{/if}}</section>
<section class="sk-box"><div style="display:flex;align-items:center;justify-content:space-between;gap:8px"><h4>Produzione mensile · data contratto</h4><div class="btn-group" role="group" aria-label="Misura produzione mensile"><button type="button" class="btn btn-default btn-xs {{#if valueMode}}active{{/if}}" data-action="monthMode" data-mode="values" aria-pressed="{{#if valueMode}}true{{else}}false{{/if}}">Valori</button><button type="button" class="btn btn-default btn-xs {{#if volume}}active{{/if}}" data-action="monthMode" data-mode="volumes" aria-pressed="{{#if volume}}true{{else}}false{{/if}}">Volumi</button></div></div><p class="sk-small">{{#if volume}}Numero contratti{{else}}Valore contratti{{/if}} · mesi recenti · {{monthRange}}</p><div class="sk-bar-legend"><span><i class="sk-segment-netti"></i>Nette</span><span><i class="sk-segment-finanziamentiRifiutati"></i>Finanziamenti KO</span><span><i class="sk-segment-recessi"></i>Recessi</span><span><i class="sk-segment-sospesi"></i>Sospesi</span></div><div class="sk-month-chart" aria-label="Vendite totali per mese">{{#each months}}<button class="sk-month-row" data-sales-key="{{key}}" data-sales-group="months" data-sales-subkey="totali" aria-label="{{key}}: {{value}}, {{count}} {{countLabel}}"><span class="sk-month-name">{{key}}</span><span class="sk-month-track" aria-hidden="true"><span class="sk-month-bar {{#if negative}}sk-negative{{/if}}" style="height:{{width}}%">{{#each segments}}<span class="sk-month-segment sk-segment-{{key}}" style="height:{{height}}%" title="{{label}}: {{value}} · {{count}} contratti"></span>{{/each}}</span></span><span class="sk-month-total"><strong>{{chartValue}}</strong><small>{{chartSecondary}}</small></span></button>{{else}}<p class="sk-small">Nessun contratto.</p>{{/each}}</div></section>
<div><section class="sk-box"><h4>Riepilogo vendite nette</h4><p class="sk-small">{{cardPeriodLabel}}</p><div class="sk-line"><span>Valore medio contratto</span><strong>{{average}}</strong></div><div class="sk-line"><span>Contratti netti / totali</span><strong>{{conversion}}</strong></div></section><section class="sk-box" style="margin-top:8px"><h4>Stati contrattuali</h4><p class="sk-small">{{cardPeriodLabel}}</p>{{#each states}}<div class="sk-line" data-sales-key="{{key}}" data-sales-group="states" tabindex="0" role="button"><span>{{key}} <span class="sk-small">({{count}})</span></span><strong>{{value}}</strong></div>{{/each}}</section><section class="sk-box" style="margin-top:8px"><h4>Da verificare</h4><p class="sk-small">{{cardPeriodLabel}}</p>{{#each alerts}}<div class="sk-line" data-sales-key="{{key}}" data-sales-group="cards" tabindex="0" role="button"><span>{{label}} <span class="sk-small">({{count}})</span></span><strong>{{value}}</strong></div>{{/each}}</section></div>
</div>{{/if}}</div>
