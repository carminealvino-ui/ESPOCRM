            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasChildren",
            "entity": "Call",
            "foreign": "parent"
        },
        "meetings": {
            "type": "hasChildren",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent"
        }
