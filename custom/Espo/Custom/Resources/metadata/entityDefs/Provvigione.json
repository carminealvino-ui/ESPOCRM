{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "pattern": "$noBadCharacters",
            "options": []
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "tipo": {
            "type": "enum",
            "options": [
                "Provvigione Base",
                "Bonus (Sabato-Domenica)",
                "Plus Provvigionale",
                "Minus Provvigionale",
                "Gara (Soglia >2.5k)",
                "Gara (Soglia >3.5)",
                "Gara (Soglia >5k)",
                "Referenza Personale",
                "Bonus Taxi"
            ],
            "default": "Provvigione Base",
            "maxLength": 100,
            "isCustom": true
        },
        "cliente": {
            "type": "link"
        },
        "contratto": {
            "type": "link"
        },
        "importo": {
            "type": "currency",
            "isCustom": true
        },
        "tassoProvvigioni": {
            "notNull": false,
            "type": "float",
            "decimalPlaces": 2,
            "isCustom": true
        },
        "baseCalcolo": {
            "type": "enum",
            "options": [
                "ImponibileContratto",
                "Plusvalenza",
                "Minusvalenza",
                "MargineSuListino",
                "CanoneMensile",
                "GettoneFisso",
                "NumeroPod"
            ],
            "isCustom": true
        },
        "importoBaseCalcolo": {
            "type": "currency",
            "isCustom": true
        },
        "contrattoArticoli": {
            "type": "link"
        },
        "hookVersion": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "statoProvvigione": {
            "type": "enum",
            "options": [
                "Forecast",
                "In pagamento",
                "Pagato",
                "Inesigibile"
            ],
            "style": {
                "Forecast": "info",
                "In pagamento": "warning",
                "Pagato": "success",
                "Inesigibile": "danger"
            },
            "default": "Forecast",
            "massUpdate": true,
            "isCustom": true
        },
        "regimeProvvigione": {
            "type": "enum",
            "options": [
                "",
                "ARQUATI_PNC",
                "ARIEL_2026",
                "GFB_VODAFONE_COEFF",
                "GFB_FASTWEB_POD",
                "GFB_RS_BIMESTRE",
                "SOLUTION_ENEL_GETTONE",
                "GENERICO"
            ],
            "isCustom": true
        },
        "dataInstallazione": {
            "type": "date",
            "useNumericFormat": true,
            "isCustom": true
        },
        "dataAttivazione": {
            "type": "date",
            "useNumericFormat": true,
            "isCustom": true
        },
        "dataCompetenza": {
            "type": "date",
            "useNumericFormat": true,
            "isCustom": true
        },
        "dataLiquidazionePrevista": {
            "type": "date",
            "readOnly": true,
            "useNumericFormat": true,
            "isCustom": true
        },
        "dataLiquidazioneEffettiva": {
            "type": "date",
            "useNumericFormat": true,
            "isCustom": true
        },
        "importoPrevisto": {
            "type": "currency",
            "isCustom": true
        },
        "importoConsolidato": {
            "type": "currency",
            "isCustom": true
        },
        "scostamentoImporto": {
            "type": "currency",
            "readOnly": true,
            "isCustom": true
        },
        "giorniLiquidazioneDaAttivazione": {
            "type": "int",
            "readOnly": true,
            "isCustom": true
        },
        "appuntamento": {
            "type": "link",
            "isCustom": true
        },
        "opportunita": {
            "type": "link",
            "isCustom": true
        },
        "productCategory": {
            "type": "link",
            "isCustom": true
        },
        "invitoAFatturare": {
            "type": "link",
            "isCustom": true
        },
        "fornitorePartner": {
            "type": "link",
            "isCustom": true
        },
        "productBrand": {
            "type": "link",
            "isCustom": true
        },
        "regolaProvvigionale": {
            "type": "link",
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "cliente": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "contratto": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "Quote",
            "audited": false,
            "isCustom": true
        },
        "contrattoArticoli": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "QuoteItem",
            "audited": false,
            "isCustom": true
        },
        "appuntamento": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "Appuntamento",
            "isCustom": true
        },
        "opportunita": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "Opportunity",
            "isCustom": true
        },
        "productCategory": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "ProductCategory",
            "isCustom": true
        },
        "invitoAFatturare": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "InvitoAFatturare",
            "isCustom": true
        },
        "fornitorePartner": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "FornitorePartner",
            "isCustom": true
        },
        "productBrand": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "ProductBrand",
            "isCustom": true
        },
        "regolaProvvigionale": {
            "type": "belongsTo",
            "foreign": "provvigioni",
            "entity": "RegolaProvvigionale",
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false
}
